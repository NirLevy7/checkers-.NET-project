@page "{PlayerId?}"
@model CheckersGame.Web.Pages.EditPlayerModel
@{ ViewData["Title"] = "Edit Player"; }

<h2>Edit Player Details</h2>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<!-- Search by ID -->
<form method="get" class="mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label fw-bold">Player ID:</label>
            <input type="number" name="PlayerId" value="@Model.PlayerId" class="form-control" style="width:120px" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-secondary">Load Player</button>
        </div>
    </div>
</form>

@if (Model.PlayerId.HasValue)
{
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="card" style="max-width:500px">
            <div class="card-header bg-dark text-white">Player ID: @Model.PlayerId (cannot be changed)</div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="Input.FirstName" class="form-label">First Name</label>
                    <input asp-for="Input.FirstName" class="form-control" />
                    <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Phone" class="form-label">Phone</label>
                    <input asp-for="Input.Phone" class="form-control" maxlength="10" />
                    <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.CountryId" class="form-label">Country</label>
                    <select asp-for="Input.CountryId" asp-items="Model.CountryOptions" class="form-select">
                        <option value="0">-- Select --</option>
                    </select>
                    <span asp-validation-for="Input.CountryId" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </div>
    </form>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
