@page
@model CheckersGame.Web.Pages.Queries.AllGamesModel
@{ ViewData["Title"] = "All Games"; }

<h2>All Games</h2>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>ID</th><th>Start</th><th>End</th><th>Duration (s)</th><th>Time/Move</th><th>Status</th><th>Players</th></tr>
    </thead>
    <tbody>
        @foreach (var g in Model.Games)
        {
            <tr>
                <td>@g.Id</td>
                <td>@g.StartTime.ToString("g")</td>
                <td>@(g.EndTime.HasValue ? g.EndTime.Value.ToString("g") : "-")</td>
                <td>
                    @if (g.EndTime.HasValue)
                    { @((int)(g.EndTime.Value - g.StartTime).TotalSeconds) }
                    else { <span>-</span> }
                </td>
                <td>@g.TimePerMoveSec s</td>
                <td>@g.Status</td>
                <td>@string.Join(", ", g.GamePlayers.Select(gp => gp.Player.FirstName))</td>
            </tr>
        }
    </tbody>
</table>
